# Public frontend configuration only. Never put secrets in VITE_* variables.
# Vercel: set this to the deployed Render backend origin.
VITE_API_URL=https://your-render-service.onrender.com

# Local development: set this to your local backend origin.
VITE_DEV_API_URL=

# Optional: public authorization URLs for an OAuth flow that returns to this app.
# Keep provider client secrets on the backend; never place secrets in VITE_* variables.
# Leave blank until the backend OAuth callback and provider configuration are implemented.
VITE_GOOGLE_OAUTH_URL=
VITE_GITHUB_OAUTH_URL=