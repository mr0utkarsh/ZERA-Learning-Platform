# VITE_API_URL points the frontend at the deployed backend.
# Only non-secret config ever reaches the browser.
#
# Set the backend ORIGIN only (no trailing "/api"): the API client appends
# "/api" itself, so including it here would produce /api/api/... requests.
# Leave it unset to use the same-origin /api path (Vercel rewrite or the Vite
# dev proxy), which is the recommended setup for the deployed frontend.
VITE_API_URL=https://zera-backend-production.up.railway.app

# ─── OAuth provider client IDs (non-secret; used to gate the OAuth buttons) ──
# The OAuth buttons only render as "available" when the corresponding client ID
# is set. If unset, they show "Not configured" instead of pretending to work.
# The actual OAuth flow always happens server-side; no secrets reach the browser.
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=