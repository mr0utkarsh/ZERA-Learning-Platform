# ============================================================
# ZERA — Environment configuration
# Copy this file to `backend/.env` and fill in real values.
# NEVER commit a real .env file.
# ============================================================

# --- Database ---
# Production (PostgreSQL — the designed target):
#   DATABASE_URL="postgresql://user:password@localhost:5432/zera?schema=public"
# Local zero-config development (SQLite fallback):
#   DATABASE_URL="file:./dev.db"
DATABASE_URL="file:./dev.db"

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# --- Auth ---
# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
# Used to encrypt admin-saved secrets (AI API keys) at rest. Falls back to
# JWT_SECRET if unset. In production, set a long random value; rotating it
# invalidates previously stored secrets.
CONFIG_ENCRYPTION_KEY=
JWT_EXPIRES_IN=7d

# --- Email (SMTP) ---
# Leave SMTP_HOST empty to disable email sending. When disabled,
# OTP codes are returned in the API response during development
# (controlled by DEV_SHOW_OTP) so flows remain testable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="ZERA <no-reply@zera.local>"

# Show OTP codes in API responses when SMTP is not configured.
# ONLY honored when NODE_ENV != production.
DEV_SHOW_OTP=true

# --- AI provider ---
# Supported: openai | none
# "none" means AI features report a clear "not configured" state.
# AI can ALSO be configured at runtime without env vars:
# Admin Panel -> Settings -> API Configuration (keys stored AES-256-GCM encrypted).
# Admin-saved settings take precedence over the env vars below.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Maximum characters of document/context sent to the AI
AI_MAX_INPUT_CHARS=8000

# --- Uploads ---
MAX_UPLOAD_MB=5

# --- Admin bootstrap (used by the seed script, development only) ---
# Initial SUPER_ADMIN account for the dev seed (never commit real values).
# The password is stored only as a bcrypt hash and never printed or returned.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

SEED_ADMIN_EMAIL=admin@zera.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STUDENT_EMAIL=student@zera.local
SEED_STUDENT_PASSWORD=Student@12345
