# ZERA Backend – Environment Variables
# Copy this file to backend/.env and fill in real values before running the server.

# ── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Transactional pooler (PgBouncer) – used by Prisma at runtime (port 6543)
DATABASE_URL="postgresql://USERNAME:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct session connection – used by Prisma for migrations/schema pushes (port 5432)
DIRECT_URL="postgresql://USERNAME:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5500

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_secure_random_string
JWT_EXPIRES_IN=7d

# ── Password Reset Token ─────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_SECRET=replace_with_secure_reset_random_string
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=replace_with_session_secret

# ── AI Providers ──────────────────────────────────────────────────────────────
# Tried in this order, first success wins: gemini -> groq -> openrouter -> deepseek
# Set at least one key. Server-side only; never exposed to the browser.
# The authoritative, fully commented copy lives in backend/.env.example.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Text-to-speech, not a completion provider: intentionally outside the chain.
ELEVENLABS_API_KEY=
AI_TIMEOUT_MS=30000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace_with_email_user
EMAIL_PASS=replace_with_email_password
EMAIL_FROM=noreply@your-domain.com
