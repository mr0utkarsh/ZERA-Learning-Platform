# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# Pooled/runtime connection (Supabase: the *pooler* host, port 6543).
DATABASE_URL=
# Direct connection, used by `prisma migrate` (port 5432). Optional.
DIRECT_URL=

# ─── Authentication secrets ───────────────────────────────────────────────────
# REQUIRED in production. Generate each independently, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never reuse one value for more than one key, and never commit a real secret.
JWT_SECRET=development-secret-change-me
JWT_EXPIRES_IN=7d
SESSION_SECRET=development-session-secret

# Signs password-reset links. Falls back to JWT_SECRET when unset, which is
# acceptable but a dedicated value limits the blast radius of a leaked key.
PASSWORD_RESET_TOKEN_SECRET=
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to call the API from a browser.
# REQUIRED in production: there is no wildcard, no `null`, and no implicit
# localhost fallback. In development an unset value allows any localhost port.
# e.g. https://username.github.io,https://zera.example.com
ALLOWED_ORIGINS=
# Canonical frontend URL, used for links in transactional email.
CLIENT_URL=http://localhost:3000

# ─── AI providers ─────────────────────────────────────────────────────────────
# Providers are tried in this order and the first success wins, so a single
# provider can be removed without breaking the AI features:
#   gemini -> groq -> openrouter -> deepseek
# Set at least one key. With none set, the AI endpoints return 503 rather than
# fabricating an answer.
#
# These are read on the server only. They are never sent to a browser, and the
# frontend always calls /api/ai/* on this backend. Rotating a key here takes
# effect on the next server restart.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter also receives CLIENT_URL and a fixed X-Title for attribution.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Text-to-speech, NOT a text-completion provider, so it is deliberately excluded
# from the failover chain above. Reserved for a future narration feature.
ELEVENLABS_API_KEY=

# Applies to every outbound AI call.
AI_TIMEOUT_MS=30000

# ─── Transactional email (password reset, admin invites) ───────────────────────
# Leave EMAIL_PROVIDER empty to disable sending. When it is set to `smtp`, a
# reset request still returns a generic success so accounts cannot be probed.
EMAIL_PROVIDER=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@example.com

# ─── Uploads ──────────────────────────────────────────────────────────────────
# Hard ceiling for a single syllabus upload, in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760

# ─── Supabase Storage (private buckets) ───────────────────────────────────────
# Project URL and the SERVICE-ROLE key (server-only; NEVER exposed to the
# browser). Buckets must be private; files are served via short-lived signed
# URLs. When unset, file-storage features degrade honestly instead of failing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SYLLABI_BUCKET=syllabi
SUPABASE_HANDWRITING_BUCKET=handwriting
SIGNED_URL_EXPIRES_IN=900

# ─── Brevo (transactional SMS + optional email API) ───────────────────────────
# Email is already delivered via Brevo SMTP above. This key enables the Brevo
# HTTP API for SMS. SMS additionally needs an approved sender, destination
# support, and credits; without them the provider's own error is surfaced.
BREVO_API_KEY=
BREVO_SMS_SENDER=ZERA
BREVO_SMS_RECIPIENT=

# ─── OCR (optional; handwriting / scanned documents) ──────────────────────────
# When unset, OCR features report "not configured" rather than inventing text.
# Set OCR_PROVIDER=http (or another label) with OCR_API_URL/OCR_API_KEY to enable.
OCR_PROVIDER=
OCR_API_URL=
OCR_API_KEY=
OCR_TIMEOUT_MS=30000

# ─── First SUPER_ADMIN bootstrap ──────────────────────────────────────────────
# Used only to create the very first platform owner, because every admin route
# requires an existing admin. Leave unset once an owner exists: the seed is
# idempotent and will never overwrite an existing account's password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Owner
